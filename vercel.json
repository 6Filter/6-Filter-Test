{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/providers.js": {
      "maxDuration": 10
    },
    "api/ideas.js": {
      "maxDuration": 180
    },
    "api/ideas/[id].js": {
      "maxDuration": 30
    },
    "api/ideas/[id]/escalate.js": {
      "maxDuration": 30
    },
    "api/ideas/[id]/export.js": {
      "maxDuration": 30
    },
    "api/category-sizing/run.js": {
      "maxDuration": 180
    },
    "api/format-trend/run.js": {
      "maxDuration": 180
    },
    "api/category-sizing/[runId]/engine/[engineId].js": {
      "maxDuration": 30
    },
    "api/category-sizing/export/[runId].js": {
      "maxDuration": 30
    },
    "api/calibration.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
