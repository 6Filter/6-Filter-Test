+/**
+ * Part 154 — compress large text answers and cache files sensibly. Node's http server does neither by itself.
+ *  - gzip only when the browser accepts it, the type is text-like (HTML, JS, CSS, JSON, SVG), the answer is at least 1 KB and not already encoded; never for HEAD, 204, 304 or images;
+ *  - the compressed copy of a file in dist/ is kept in memory (files are immutable between deploys), an API answer is compressed fresh and asynchronously (it never blocks the server);
+ *  - files whose name carries a hash (/assets/index-AbC123.js) are cached for a year; index.html is never served stale; everything under /api is never cacheable (it is private data).
+ */
+import zlib from "node:zlib";
+const COMPRESSIBLE = /^(text\/|application\/(json|javascript|xml)|image\/svg\+xml)/i;
+const MIN_BYTES = 1024;
+const memo = new Map();
+export function cacheHeaderFor(urlPath) {
+  const p = String(urlPath || "/").split("?")[0];
+  if (p.startsWith("/api/")) return "no-store";
+  if (/^\/assets\/.+-[A-Za-z0-9_-]{6,}\.[a-z0-9]+$/i.test(p)) return "public, max-age=31536000, immutable";
+  if (p === "/" || p.endsWith(".html")) return "no-cache";
+  return "public, max-age=3600";
+}
+export function applyHttpPerformance(req, res) {
+  if (!res.getHeader("Cache-Control")) res.setHeader("Cache-Control", cacheHeaderFor(req.url));
+  const accepts = /\bgzip\b/i.test(String(req.headers["accept-encoding"] || ""));
+  if (!accepts || req.method === "HEAD") return;
+  const origEnd = res.end.bind(res), origWrite = res.write.bind(res); let wrote = false;
+  res.write = (...a) => { wrote = true; return origWrite(...a); };
+  res.end = (chunk, enc, cb) => {
+    if (wrote || res.headersSent || res.getHeader("Content-Encoding") || chunk == null || typeof chunk === "function") return origEnd(chunk, enc, cb);
+    const body = Buffer.isBuffer(chunk) ? chunk : Buffer.from(String(chunk), typeof enc === "string" ? enc : "utf8");
+    const type = String(res.getHeader("Content-Type") || ""); const st = res.statusCode;
+    if (body.length < MIN_BYTES || st < 200 || st === 204 || st === 304 || !COMPRESSIBLE.test(type)) return origEnd(chunk, enc, cb);
+    const key = `${req.url.split("?")[0]}|${body.length}`; const cached = req.url.startsWith("/assets/") ? memo.get(key) : null;
+    const send = (z) => { res.setHeader("Content-Encoding", "gzip"); res.setHeader("Vary", "Accept-Encoding"); res.setHeader("Content-Length", z.length); origEnd(z); };
+    if (cached) { send(cached); return res; }
+    zlib.gzip(body, { level: 6 }, (err, z) => { if (err || z.length >= body.length) { res.setHeader("Vary", "Accept-Encoding"); return origEnd(body); } if (req.url.startsWith("/assets/")) memo.set(key, z); send(z); });
+    return res;
+  };
