+/** All review events for many ideas in ONE query, grouped by idea (oldest first), so a list of N ideas costs one call, not N. */
+export async function listManagerReviewEventsForIdeas(ideaIds = [], { limitPerIdea = 100 } = {}) {
+  await ensureManagerReviewEventsSchema();
+  const out = new Map();
+  if (!usingPostgres()) return out;
+  const ids = [...new Set((ideaIds || []).map((id) => String(id || "").trim()).filter(Boolean))];
+  for (const id of ids) out.set(id, []);
+  if (!ids.length) return out;
+  const rows = await query(`SELECT * FROM manager_review_events WHERE idea_id = ANY($1::text[]) ORDER BY idea_id, created_at ASC`, [ids]);
+  for (const r of rows) { const list = out.get(r.idea_id); if (list && list.length < limitPerIdea) list.push(r); }
+  return out;
+}
