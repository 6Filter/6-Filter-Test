{
  "name": "primus-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "seed-user": "node scripts/seedUser.js",
    "set-role": "node scripts/setRole.mjs",
    "issue-login-code": "node scripts/issueLoginCode.mjs",
    "check:locks": "node scripts/checkNoDuplicateThresholds.mjs && node scripts/checkDivisionFloorsLocked.mjs",
    "test:regression": "node scripts/checkNoDuplicateThresholds.mjs && node scripts/scanCommittedSecrets.mjs && npm run build && node scripts/checkClientBundle.mjs && node scripts/run-all-tests.mjs && node scripts/testPostgresNoClobber.mjs",
    "test:postgres": "node scripts/testPostgresNoClobber.mjs",
    "scratch-postgres": "node scripts/startScratchPostgres.mjs",
    "verify:all": "node scripts/verifyAll.mjs",
    "install:prod": "npm ci --include=dev --omit=optional"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.12.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.8.1",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "29.1.1",
    "vite": "^5.3.4"
  },
  "optionalDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "axe-core": "^4.14.1",
    "c8": "^12.0.0",
    "fast-check": "^4.10.3"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
