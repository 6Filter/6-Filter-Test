# Claude (Anthropic) — default. Server-side only
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional comparison models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# PostgreSQL (required on Render)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Login / roles are parked. Set REQUIRE_AUTH=true (and SESSION_SECRET) to turn them on.
# REQUIRE_AUTH=true
# SESSION_SECRET=change-me-before-deploy

# Browser origin allowed to send credentialed API requests. Same-origin on Render does not need this to match.
# ALLOWED_ORIGIN=https://6-filter-test.onrender.com
