# Claude (Anthropic) — server-side only
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# PostgreSQL (required on Render)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Login / roles are parked. Set REQUIRE_AUTH=true (and SESSION_SECRET) to turn them on.
# REQUIRE_AUTH=true
# SESSION_SECRET=change-me-before-deploy

# Browser origin allowed to send credentialed API requests. Same-origin on Render does not need this to match.
# ALLOWED_ORIGIN=https://ck-6-filter-test.onrender.com

# Incoming Webhook for WATCH manager-review notices (Apps → Incoming Webhooks). Server-only.
# Without this, Request manager review still records in the app; Slack is skipped with a warning.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# Public URL used in the Slack message link (defaults to the Render app).
# APP_PUBLIC_URL=https://ck-6-filter-test.onrender.com
