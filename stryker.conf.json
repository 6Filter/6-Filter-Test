{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "mutate": ["lib/researchIncompleteDiag.js"],
  "testRunner": "command",
  "coverageAnalysis": "off",
  "commandRunner": {
    "command": "node --input-type=module -e \"process.env.REQUIRE_POSTGRES_TESTS='0'; process.env.TEST_DATABASE_URL=''; await import('./scripts/testResearchIncompleteDiag.mjs')\""
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 90, "low": 90, "break": 80 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true
}
